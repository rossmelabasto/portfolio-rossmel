---
import type { Lang } from '../data/profile';
import { visibleProjects as projects } from '../data/profile';
import { t, paths } from '../data/i18n';
import Sketch from './Sketch.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<section
  id="work"
  data-horizontal
  role="region"
  aria-label={s.work.scrollRegion}
  tabindex="0"
  class="relative overflow-hidden md:h-screen md:overflow-x-auto md:overscroll-x-contain md:snap-x md:snap-mandatory md:focus-visible:outline md:focus-visible:outline-2 md:focus-visible:outline-offset-4 md:focus-visible:outline-accent"
>
  <div
    data-track
    class="flex h-full flex-col gap-6 px-5 py-24 md:flex-row md:items-center md:gap-10 md:px-10 md:py-0"
  >
    <div class="shrink-0 md:w-[38vw] md:snap-start md:pr-[3vw]">
      <p class="kicker mb-6">{s.work.kicker}</p>
      <h2 class="display text-6xl font-bold md:text-[clamp(2.3rem,4.8vw,4.32rem)]">{s.work.title}</h2>
      <Sketch name="scribble" seed={6} class="mt-2 h-4 w-3/4 text-accent" />
      <p class="mt-6 font-mono text-sm text-muted">({String(featured.length).padStart(2, '0')}) →</p>
      <div class="mt-8 hidden items-center gap-2 text-accent md:flex" aria-hidden="true">
        <span class="font-hand text-3xl">{s.work.swipe}</span>
        <Sketch name="swipe" seed={8} class="h-10 w-28" />
      </div>
    </div>
    <ol data-stack class="border-t border-line md:hidden" style={`--n:${featured.length}`}>
      {featured.map((p, i) => (
        <li data-stack-item style={`--c:${p.accent}`} class="border-b border-line">
          <a href={paths.project(lang, p.slug)} class="block no-underline">
            <span class="flex items-baseline gap-3 py-3">
              <span class="w-6 shrink-0 font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span data-stack-name class="display flex-1 text-2xl font-semibold">{p.name}</span>
              <span class="font-mono text-xs text-muted">{p.year}</span>
            </span>
            <span data-stack-body class="grid">
              <span class="min-h-0 overflow-hidden">
                <span data-stack-media class="relative mb-3 block overflow-hidden rounded-2xl border border-line bg-bg-2" style={`background: radial-gradient(120% 90% at ${20 + i * 15}% 20%, color-mix(in oklab, ${p.accent} 70%, transparent), transparent 60%), radial-gradient(90% 90% at 90% 100%, color-mix(in oklab, ${p.accent} 30%, transparent), transparent 70%);`}>
                  {p.doodle && <Sketch name={p.doodle} seed={i + 61} draw={false} class="absolute right-[8%] top-1/2 h-[62%] w-[42%] -translate-y-1/2 -rotate-6 text-fg/70" />}
                </span>
                <span class="flex items-start justify-between gap-4 pb-4">
                  <span class="min-h-[4.5rem] text-muted">{p.tagline[lang]}</span>
                  <span class="kicker shrink-0 text-[var(--c)]">{s.work.view} ↗</span>
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    {featured.map((p, i) => (
      <a data-card data-hover data-draw-host href={paths.project(lang, p.slug)} class="group relative hidden shrink-0 no-underline md:block md:w-[42vw] md:snap-center" style={`--c:${p.accent}`}>
        <div class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-line bg-bg-2">
          <div data-card-media class="absolute inset-0" style={`background: radial-gradient(120% 90% at ${20 + i * 15}% 20%, color-mix(in oklab, ${p.accent} 70%, transparent), transparent 60%), radial-gradient(90% 90% at 90% 100%, color-mix(in oklab, ${p.accent} 30%, transparent), transparent 70%);`}></div>
          <span class="display absolute bottom-4 left-6 text-[9vw] font-bold leading-none text-fg/90 mix-blend-overlay md:text-[clamp(2.88rem,6vw,5.4rem)]">{p.name}</span>
          {p.doodle && <Sketch name={p.doodle} seed={i + 61} class="absolute right-[8%] top-1/2 h-[42%] w-[42%] -translate-y-1/2 -rotate-6 text-fg/70" />}
          <span class="absolute right-5 top-5 font-mono text-xs text-fg/70">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <div class="mt-5 flex items-start justify-between gap-6">
          <div class="min-w-0">
            <h3 class="display text-2xl font-semibold">{p.name} <span class="text-muted">· {p.year}</span></h3>
            <p class="mt-1 text-muted md:min-h-[4.5rem]">{p.tagline[lang]}</p>
          </div>
          <span class="kicker shrink-0 transition-colors group-hover:text-[var(--c)]">{s.work.view} ↗</span>
        </div>
      </a>
    ))}
    <div class="w-[5vw] shrink-0"></div>
  </div>
</section>

<section class="px-5 py-24 md:px-10">
  <ul class="border-t border-line">
    {others.map((p, i) => (
      <li class="border-b border-line" data-reveal>
        <a href={paths.project(lang, p.slug)} data-hover data-draw-host class="group flex flex-col gap-2 py-6 transition-colors hover:text-accent md:grid md:grid-cols-12 md:items-baseline md:gap-4">
          <span class="display flex items-center gap-4 text-3xl font-semibold md:col-span-4 md:text-5xl">{p.name}{p.doodle && <Sketch name={p.doodle} seed={i + 71} class="h-9 w-9 shrink-0 text-accent md:h-11 md:w-11" />}</span>
          <span class="hidden text-muted md:col-span-5 md:block">{p.tagline[lang]}</span>
          <span class="kicker md:col-span-3 md:text-right">{p.kind[lang]} · {p.year}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Lista móvil de proyectos destacados. Sin JS o con movimiento reducido: filas con su descripción.
     Con .is-live (animations.ts → initStack) la lista queda fija y solo el proyecto activo se abre. */
  [data-stack-media] { display: none; height: clamp(5.5rem, calc(100svh - 84px - var(--n) * 3.3rem - 11rem), 12rem); }
  [data-stack-body] { grid-template-rows: 1fr; transition: grid-template-rows 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s; }
  [data-stack-name] { transition: color 0.3s, opacity 0.3s; }
  :global(.is-live) [data-stack-media] { display: block; }
  :global(.is-live) [data-stack-item]:not([data-active]) [data-stack-body] { grid-template-rows: 0fr; opacity: 0; }
  :global(.is-live) [data-stack-item]:not([data-active]) [data-stack-name] { opacity: 0.45; }
  :global(.is-live) [data-stack-item][data-active] [data-stack-name] { color: var(--c); }
</style>
